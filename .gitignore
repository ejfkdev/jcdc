# Rust build artifacts
/target
**/*.rs.bk

# OS / editor cruft
.DS_Store

# Backup files
*.bak
*.bak2

# Large, externally-reproducible corpus. The JDKs and their extracted src.zip
# are downloaded per corpus/jdks/MANIFEST.json; verify-work is scratch output.
/corpus/jdks/*
!/corpus/jdks/MANIFEST.json
/corpus/jdk-sources/
/corpus/verify-work/

# Compiled feature-suite class output (regenerated by scripts/verify.py)
/corpus/features/classes*/
corpus/census-trees/
__pycache__/
